# Copy this file to .env and fill in real values. .env itself is gitignored.

# --- Current setup: SQLite ---
# Zero install required -- this just becomes a file on disk at data/processed/employee.db.
# ETL_DATABASE_URL is used by main.py / the ETL pipeline (needs write access).
ETL_DATABASE_URL=sqlite:///data/processed/employee.db

# AGENT_DATABASE_URL is what the LangChain agent will use in Phase 3.
# The "mode=ro" + "uri=true" flags open the SAME file in read-only mode --
# this is SQLite's closest equivalent to a read-only DB role, since SQLite
# has no user/permission system of its own. It's a development-time
# safeguard, not a hard guarantee (a process could still open the file
# directly without this flag), so don't rely on it once this is handling
# anything sensitive.
AGENT_DATABASE_URL=sqlite:///file:data/processed/employee.db?mode=ro&uri=true


# --- Later: Postgres (uncomment and fill in once you migrate) ---
# Run sql/01_schema.sql's table creation is handled by code (src/schema.py)
# regardless of backend, but sql/02_roles.sql must be run manually against
# Postgres to create the etl_writer / agent_readonly roles with real grants --
# that's what makes AGENT_DATABASE_URL's read-only guarantee enforced by the
# database itself rather than just a connection flag.
#
# ETL_DATABASE_URL=postgresql+psycopg2://etl_writer:change_me_writer@localhost:5432/employee_db
# AGENT_DATABASE_URL=postgresql+psycopg2://agent_readonly:change_me_readonly@localhost:5432/employee_db
